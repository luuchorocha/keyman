#!/bin/sh

set -u

SSH_DIR="${SSH_DIR:-"$HOME/.ssh"}"
NO_COLOR="${NO_COLOR:-}"
KEYMAN_DIR="${KEYMAN_DIR:-$(cd "$(dirname "$(realpath $0)")" && pwd)}"
KEYMAN_LIB="$KEYMAN_DIR/keyman.d"
KEYMAN_LOG="${KEYMAN_LOG:-}"
VERSION="$(cat "$KEYMAN_LIB/VERSION")"

trap cleanup EXIT
trap interrupt INT TERM

cleanup() {
  if command -v restore_tty >/dev/null 2>&1; then
    restore_tty
  fi
  rm -f "${TMPDIR:-/tmp}"/keyman.* 2>/dev/null
}

interrupt() {
  cleanup
  exit 130
}

load() {
  module="$1"
  if [ -f "$KEYMAN_LIB/$module" ]; then
    # shellcheck source=/dev/null
    . "$KEYMAN_LIB/$module"
  else
    printf 'error: module not found: %s\n' "$KEYMAN_LIB/$module" >&2
    exit 1
  fi
}

subcommand="${1:-}"

if [ "$subcommand" = "install" ]; then
  if [ -f "$KEYMAN_LIB/install.sh" ]; then
    "$KEYMAN_LIB/install.sh"
    exit 0
  else
    printf 'error: install script not found: %s\n' "$KEYMAN_LIB/install.sh" >&2
    exit 1
  fi
elif [ "$subcommand" = "uninstall" ]; then
  if [ -f "$KEYMAN_LIB/uninstall.sh" ]; then
    "$KEYMAN_LIB/uninstall.sh"
    exit 0
  else
    printf 'error: uninstall script not found: %s\n' "$KEYMAN_LIB/uninstall.sh" >&2
    exit 1
  fi
fi

load "help.sh"
load "cli.sh"
load "core.sh"
load "ui.sh"
load "ssh.sh"
load "gpg.sh" 
load "menu.sh"

parse_arguments "$@"
main_menu "$@"
