#!/bin/sh
# keyman — SSH keys + GPG keys manager (POSIX sh)

set -u

SSH_DIR="${SSH_DIR:-"$HOME/.ssh"}"
KEYMAN_LOG="${KEYMAN_LOG:-}"  # Set to 'syslog' or a file path to enable audit logging
NO_COLOR="${NO_COLOR:-}"
KEYMAN_DIR="$(cd "$(dirname "$(realpath $0)")" && pwd)"
KEYMAN_LIB="$KEYMAN_DIR/keyman.d"
VERSION=$(cat "$KEYMAN_LIB/VERSION")

trap cleanup EXIT
trap interrupt INT TERM

cleanup() {
  rm -f "${TMPDIR:-/tmp}"/keyman.* 2>/dev/null
}

interrupt() {
  cleanup
  exit 130
}

load() {
  module="$1"
  if [ -f "$KEYMAN_LIB/$module" ]; then
    # shellcheck source=/dev/null
    . "$KEYMAN_LIB/$module"
  else
    printf 'error: module not found: %s\n' "$KEYMAN_LIB/$module" >&2
    exit 1
  fi
}

load "core.sh"
load "help.sh"
load "ui.sh"
load "ssh.sh"
load "gpg.sh"
load "menu.sh"

main_menu $@
